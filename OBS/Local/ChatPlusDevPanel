-- ==========================================
-- Script distant : ChatPlusDevPanel
-- ==========================================
print("[ChatPlus] Initialisation du panneau DevPanel...")

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer or Players.PlayerAdded:Wait()
local playerGui = LocalPlayer:WaitForChild("PlayerGui")

-- Supprimer l'ancienne interface si elle existe déjà
local existingGui = playerGui:FindFirstChild("GitHubTestGui")
if existingGui then
	existingGui:Destroy()
end

-- Création du ScreenGui
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "GitHubTestGui"
screenGui.ResetOnSpawn = false

-- Création de l'étiquette de texte (TextLabel)
local textLabel = Instance.new("TextLabel")
textLabel.Size = UDim2.new(0, 350, 0, 60)
textLabel.Position = UDim2.new(0.5, -175, 0.2, 0)
textLabel.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
textLabel.TextSize = 20
textLabel.Font = Enum.Font.SourceSansBold
textLabel.Text = " Test GitHub réussi ! "
textLabel.BorderSizePixel = 0

-- Application des arrondis aux coins (UICorner)
local uiCorner = Instance.new("UICorner")
uiCorner.CornerRadius = UDim.new(0, 8)
uiCorner.Parent = textLabel

-- Parenter les éléments
textLabel.Parent = screenGui
screenGui.Parent = playerGui

print("[ChatPlus] Panneau DevPanel affiché avec succès !")
